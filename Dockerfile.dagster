# Dagster webserver + daemon image for the Open Data Lakehouse.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    DAGSTER_HOME=/app/.dagster \
    PYTHONPATH=/app/orchestration/ingestion/src:/app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
    ca-certificates curl git default-jre-headless build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir "uv>=0.4"

WORKDIR /app

ARG MAVEN_BASE=https://repo1.maven.org/maven2
# These must stay in lockstep with ``Dockerfile.spark``. The Dagster container
# creates its own local SparkSession (``iceberg/session.py``) to write Delta
# tables, so it needs the same Iceberg/Delta/Hadoop trio as the Thrift server;
# a mismatch shows up as a NoSuchMethodError buried in a Spark stack trace.
# Kept ahead of COPY steps so code/SQL/YAML edits never invalidate the JAR
# download or uv dependency layers.
RUN set -eux; \
    mkdir -p /opt/spark-jars; \
    curl -fL "${MAVEN_BASE}/org/apache/iceberg/iceberg-spark-runtime-4.1_2.13/1.12.0/iceberg-spark-runtime-4.1_2.13-1.12.0.jar" \
    -o /opt/spark-jars/iceberg-spark-runtime-4.1_2.13-1.12.0.jar; \
    curl -fL "${MAVEN_BASE}/org/apache/iceberg/iceberg-aws-bundle/1.12.0/iceberg-aws-bundle-1.12.0.jar" \
    -o /opt/spark-jars/iceberg-aws-bundle-1.12.0.jar; \
    curl -fL "${MAVEN_BASE}/org/apache/hadoop/hadoop-aws/3.4.2/hadoop-aws-3.4.2.jar" \
    -o /opt/spark-jars/hadoop-aws-3.4.2.jar; \
    curl -fL "${MAVEN_BASE}/com/amazonaws/aws-java-sdk-bundle/1.12.720/aws-java-sdk-bundle-1.12.720.jar" \
    -o /opt/spark-jars/aws-java-sdk-bundle-1.12.720.jar; \
    curl -fL "${MAVEN_BASE}/io/delta/delta-spark_2.13/4.3.1/delta-spark_2.13-4.3.1.jar" \
    -o /opt/spark-jars/delta-spark_2.13-4.3.1.jar; \
    curl -fL "${MAVEN_BASE}/io/delta/delta-storage/4.3.1/delta-storage-4.3.1.jar" \
    -o /opt/spark-jars/delta-storage-4.3.1.jar; \
    curl -fL "${MAVEN_BASE}/io/delta/delta-iceberg_2.13/4.3.1/delta-iceberg_2.13-4.3.1.jar" \
    -o /opt/spark-jars/delta-iceberg_2.13-4.3.1.jar

COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --extra spark --extra dbt --extra postgres --no-dev --no-install-project

# hadoop-aws 3.4.2 uses AWS SDK v2 S3TransferManager + ApacheHttpClient, which
# iceberg-aws-bundle (2.54.17) omits. Kept after uv sync so existing heavy
# download layers remain cached.
RUN set -eux; \
    curl -fL "${MAVEN_BASE}/software/amazon/awssdk/s3-transfer-manager/2.54.17/s3-transfer-manager-2.54.17.jar" \
    -o /opt/spark-jars/s3-transfer-manager-2.54.17.jar; \
    curl -fL "${MAVEN_BASE}/software/amazon/awssdk/apache-client/2.54.17/apache-client-2.54.17.jar" \
    -o /opt/spark-jars/apache-client-2.54.17.jar

COPY orchestration ./orchestration
COPY dbt_lakehouse ./dbt_lakehouse
COPY use_case ./use_case
COPY workspace.yaml ./
# NOTE: dagster-instance.yaml is intentionally NOT copied. It has to live at
# $DAGSTER_HOME/dagster.yaml, and the ``dagster-home`` volume would shadow
# anything baked into /app/.dagster; docker-compose bind-mounts the single file
# into the volume instead.

# dbt v2 compiles the Spark adapter into its own binary but still gates it
# behind this variable: without it every command aborts with `dbt1005` before
# parsing anything, which would break both this build step and `make dbt-*`.
ENV DBT_ALLOW_EXPERIMENTAL_ADAPTERS=true \
    DBT_SEND_ANONYMOUS_USAGE_STATS=false

RUN cd /app/dbt_lakehouse \
    && DBT_PROFILES_DIR=/app/dbt_lakehouse /app/.venv/bin/dbt parse

RUN mkdir -p /app/.dagster

ENV PATH="/app/.venv/bin:${PATH}" \
    SPARK_JARS_DIR=/opt/spark-jars

EXPOSE 3000

CMD ["dagster-webserver", "-h", "0.0.0.0", "-p", "3000", "-w", "/app/workspace.yaml"]
