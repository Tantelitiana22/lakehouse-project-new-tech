# Copy to .env and adjust if needed. docker-compose ships working defaults.
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfssecret

S3_ENDPOINT_URL=http://rustfs:9000
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfssecret
S3_REGION=us-east-1

UC_BASE_URL=http://unity-catalog:8080
UC_CATALOG=lakehouse
UC_SCHEMA=bronze
UC_STORAGE_ROOT=s3://lakehouse/warehouse

SPARK_THRIFT_HOST=spark-thrift
SPARK_THRIFT_PORT=10000
SPARK_MASTER=local[*]
SPARK_WAREHOUSE=s3://lakehouse/warehouse
