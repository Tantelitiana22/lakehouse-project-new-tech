[flake8]
# 100 is the project-wide line length (see [tool.ruff] in pyproject.toml).
max-line-length = 100

# E203 (whitespace before ':') and W503 (line break before binary operator) are
# both produced by black's formatting, so flake8 and black disagree on them.
extend-ignore = E203, W503

exclude =
    .git,
    .venv,
    __pycache__,
    build,
    dist,
    dbt_lakehouse/target,
    dbt_lakehouse/dbt_packages
